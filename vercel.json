{
  "installCommand": "npm ci --no-workspaces",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/catalog-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/voice-availability",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/journey-slot-counts",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/revalidate-qa-pass",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-metrics",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/claim-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/beta-lifecycle",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/journey-bridge-push",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/resume-story-push",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/next-story-push",
      "schedule": "0 19 * * *"
    }
  ]
}
