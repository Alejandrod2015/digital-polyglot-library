 "segments": [
  {
   "id": "sentence-1",
   "text": "Du stehst an der Kasse, hältst die Karte hin, und der Mann hinter dem Tresen zeigt auf ein kleines Schild: nur Bargeld.",
   "normalizedText": "du stehst an der kasse hältst die karte hin und der mann hinter dem tresen zeigt auf ein kleines schild nur bargeld",
   "startSec": 2.6,
   "endSec": 11.623333,
   "index": 0
  },
  {
   "id": "sentence-2",
   "text": "Kein Automat in der Nähe.",
   "normalizedText": "kein automat in der nähe",
   "startSec": 11.68,
   "endSec": 14.3,
   "index": 1
  },
  {
   "id": "sentence-3",
   "text": "Draußen regnet es.",
   "normalizedText": "draußen regnet es",
   "startSec": 14.32,
   "endSec": 15.359312,
   "index": 2
  },
  {
   "id": "sentence-4",
   "text": "Er ist weder altmodisch noch stur.",
   "normalizedText": "er ist weder altmodisch noch stur",
   "startSec": 15.4,
   "endSec": 18.46,
   "index": 3
  },
  {
   "id": "sentence-5",
   "text": "Für ihn ist dein Schein schlicht billiger.",
   "normalizedText": "für ihn ist dein schein schlicht billiger",
   "startSec": 18.48,
   "endSec": 21.900000000000002,
   "index": 4
  },
  {
   "id": "sentence-6",
   "text": "Die Bundesbank hat nachgerechnet, was den Handel jede Zahlung kostet: bar rund vierundzwanzig Cent, mit Kreditkarte fast einen Euro.",
   "normalizedText": "die bundesbank hat nachgerechnet was den handel jede zahlung kostet bar rund vierundzwanzig cent mit kreditkarte fast einen euro",
   "startSec": 21.92,
   "endSec": 32.26,
   "index": 5
  },
  {
   "id": "sentence-7",
   "text": "Bei einem Kaffee für drei Euro ist das kein Rundungsfehler.",
   "normalizedText": "bei einem kaffee für drei euro ist das kein rundungsfehler",
   "startSec": 32.28,
   "endSec": 37.18,
   "index": 6
  },
  {
   "id": "sentence-8",
   "text": "Es geht auch schneller.",
   "normalizedText": "es geht auch schneller",
   "startSec": 37.2,
   "endSec": 38.82,
   "index": 7
  },
  {
   "id": "sentence-9",
   "text": "Eine Barzahlung dauert an der Kasse gut zwanzig Sekunden, eine Kartenzahlung mit Unterschrift fast vierzig.",
   "normalizedText": "eine barzahlung dauert an der kasse gut zwanzig sekunden eine kartenzahlung mit unterschrift fast vierzig",
   "startSec": 38.84,
   "endSec": 47.339999999999996,
   "index": 8
  },
  {
   "id": "sentence-10",
   "text": "Und er ist damit nicht allein: In Deutschland wird immer noch jede zweite Zahlung bar gemacht.",
   "normalizedText": "und er ist damit nicht allein in deutschland wird immer noch jede zweite zahlung bar gemacht",
   "startSec": 47.36,
   "endSec": 54.779999999999994,
   "index": 9
  },
  {
   "id": "sentence-11",
   "text": "Bei den Kunden steht ganz oben nicht die Nostalgie, sondern der Stromausfall.",
   "normalizedText": "bei den kunden steht ganz oben nicht die nostalgie sondern der stromausfall",
   "startSec": 54.8,
   "endSec": 61.22,
   "index": 10
  },
  {
   "id": "sentence-12",
   "text": "Bargeld funktioniert, wenn die Technik nicht funktioniert.",
   "normalizedText": "bargeld funktioniert wenn die technik nicht funktioniert",
   "startSec": 61.24,
   "endSec": 65.486562,
   "index": 11
  },
  {
   "id": "sentence-13",
   "text": "Danach kommt, dass Kinder mit Münzen lernen, was Geld überhaupt ist.",
   "normalizedText": "danach kommt dass kinder mit münzen lernen was geld überhaupt ist",
   "startSec": 65.52,
   "endSec": 70.42,
   "index": 12
  },
  {
   "id": "sentence-14",
   "text": "Und der Datenschutz: Ein Schein verrät niemandem, wo du am Dienstagabend warst.",
   "normalizedText": "und der datenschutz ein schein verrät niemandem wo du am dienstagabend warst",
   "startSec": 70.44,
   "endSec": 76.74000000000001,
   "index": 13
  },
  {
   "id": "sentence-15",
   "text": "Und dann kommt der Widerspruch.",
   "normalizedText": "und dann kommt der widerspruch",
   "startSec": 76.76,
   "endSec": 79.38000000000001,
   "index": 14
  },
  {
   "id": "sentence-16",
   "text": "Mehr als die Hälfte derselben Befragten sagt, Bargeld erleichtere Schwarzarbeit und Steuerhinterziehung, und genau deshalb solle man es einschränken.",
   "normalizedText": "mehr als die hälfte derselben befragten sagt bargeld erleichtere schwarzarbeit und steuerhinterziehung und genau deshalb solle man es einschränken",
   "startSec": 79.4,
   "endSec": 90.42,
   "index": 15
  },
  {
   "id": "sentence-17",
   "text": "Neunundsechzig Prozent wollen bar zahlen können.",
   "normalizedText": "neunundsechzig prozent wollen bar zahlen können",
   "startSec": 90.44,
   "endSec": 94.58,
   "index": 16
  },
  {
   "id": "sentence-18",
   "text": "Über die Hälfte findet, dass genau das ein Problem ist.",
   "normalizedText": "über die hälfte findet dass genau das ein problem ist",
   "startSec": 94.6,
   "endSec": 98.62,
   "index": 17
  },
  {
   "id": "sentence-19",
   "text": "Der Mann hinter dem Tresen wartet immer noch.",
   "normalizedText": "der mann hinter dem tresen wartet immer noch",
   "startSec": 98.64,
   "endSec": 101.94,
   "index": 18
  },
  {
   "id": "sentence-20",
   "text": "Draußen regnet es weiter.",
   "normalizedText": "draußen regnet es weiter",
   "startSec": 101.96,
   "endSec": 104.56,
   "index": 19
  }
 ]
