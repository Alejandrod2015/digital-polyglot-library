{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/safety/pre-bash-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/pre-story-save-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/pre-voice-approval-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/pre-cover-style-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/safety/pre-topic-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/safety/pre-voice-approval-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/pre-cover-style-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/pre-emdash-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/safety/stop-single-rec-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/stop-recommendation-basis-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/stop-story-audio-link-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/safety/stop-word-budget-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/safety/post-audio-contract.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/safety/post-story-save-glosses.sh"
          }
        ]
      }
    ]
  }
}